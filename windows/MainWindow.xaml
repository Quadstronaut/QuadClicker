<Window x:Class="QuadClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuadClicker"
        Width="430"
        MinWidth="380" MinHeight="472"
        SizeToContent="Height"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <DockPanel LastChildFill="True">

        <!-- ── Update banner (non-modal; visible only when an update is available) ── -->
        <Border x:Name="UpdateBanner"
                DockPanel.Dock="Top"
                Visibility="Collapsed"
                Background="{StaticResource SurfaceElevatedBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateBannerHeadline"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="UpdateBannerSubtext"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" Margin="0,2,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="UpdateBtn" Content="Update" Width="62"
                            Style="{StaticResource SmallButtonStyle}"
                            Click="UpdateBtn_Click" />
                    <Button x:Name="UpdateSkipBtn" Content="Skip" Width="48" Margin="6,0,0,0"
                            Style="{StaticResource SmallButtonStyle}"
                            Click="UpdateSkip_Click"
                            ToolTip="Dismiss for this session" />
                    <Button x:Name="UpdateSkipVersionBtn" Content="Skip this version" Width="120" Margin="6,0,0,0"
                            Style="{StaticResource SmallButtonStyle}"
                            Click="UpdateSkipVersion_Click"
                            ToolTip="Don't ask again until a newer version appears" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Click Rate -->
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />  <!-- Button -->
            <RowDefinition Height="Auto" />  <!-- Type -->
            <RowDefinition Height="Auto" />  <!-- Location -->
            <RowDefinition Height="Auto" />  <!-- XY + Pick -->
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />  <!-- Separator: Stop Conditions -->
            <RowDefinition Height="Auto" />  <!-- After clicks -->
            <RowDefinition Height="Auto" />  <!-- After seconds -->
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />  <!-- Separator: Advanced -->
            <RowDefinition Height="Auto" />  <!-- Idle + Always on top -->
            <RowDefinition Height="Auto" />  <!-- Hotkeys -->
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />  <!-- Inline error label -->
            <RowDefinition Height="Auto" />  <!-- Status + click count -->
            <RowDefinition Height="8" />
            <RowDefinition Height="38" />    <!-- Start/Stop button -->
            <RowDefinition Height="Auto" />  <!-- Version label -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="155" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Click Rate ──────────────────────────────────────────────────── -->
        <Label Grid.Row="0" Grid.Column="0" Content="Click Rate:"
               VerticalAlignment="Top" Margin="0,4,0,0" />
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                <RadioButton x:Name="ModeDelay" Content="Delay"
                             GroupName="ClickRateMode" IsChecked="True"
                             Checked="ClickRateMode_Changed"
                             ToolTip="Set the time between clicks" />
                <RadioButton x:Name="ModeFrequency" Content="Frequency"
                             GroupName="ClickRateMode" Margin="0"
                             Checked="ClickRateMode_Changed"
                             ToolTip="Set how often clicks happen" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="ClickRateValueBox" Width="80" Text="100"
                         TextChanged="ClickRateInput_Changed"
                         ToolTip="Enter a number. Unit selected on the right." />
                <ComboBox x:Name="ClickRateUnitBox" Width="110" Margin="6,2,0,2"
                          SelectionChanged="ClickRateUnit_SelectionChanged"
                          ToolTip="Unit for the click rate value" />
            </StackPanel>
            <TextBlock x:Name="RateHintLabel"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11" Margin="2,3,0,2"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- ── Mouse Button ────────────────────────────────────────────────── -->
        <Label Grid.Row="2" Grid.Column="0" Content="Mouse Button:" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <RadioButton x:Name="BtnLeft"   Content="Left"   GroupName="MouseBtn" IsChecked="True" />
            <RadioButton x:Name="BtnRight"  Content="Right"  GroupName="MouseBtn" />
            <RadioButton x:Name="BtnMiddle" Content="Middle" GroupName="MouseBtn" Margin="0" />
        </StackPanel>

        <!-- ── Click Type ─────────────────────────────────────────────────── -->
        <Label Grid.Row="3" Grid.Column="0" Content="Click Type:"
               VerticalAlignment="Center" Margin="0,-2,0,0" />
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <RadioButton x:Name="TypeSingle" Content="Single" GroupName="ClickType" IsChecked="True" />
            <RadioButton x:Name="TypeDouble" Content="Double" GroupName="ClickType" Margin="0" />
        </StackPanel>

        <!-- ── Location ────────────────────────────────────────────────────── -->
        <Label Grid.Row="4" Grid.Column="0" Content="Location:" />
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <RadioButton x:Name="LocCurrent"  Content="Current"  GroupName="ClickLoc" IsChecked="True" />
            <RadioButton x:Name="LocFixed"    Content="Fixed XY" GroupName="ClickLoc" Margin="0" />
        </StackPanel>

        <!-- ── XY + Pick ────────────────────────────────────────────────────── -->
        <Label Grid.Row="5" Grid.Column="0" Content="Coordinates (X, Y):" />
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBox x:Name="XBox" Width="52" Margin="0,2,0,2"
                     IsEnabled="{Binding IsChecked, ElementName=LocFixed}"
                     ToolTip="X coordinate (pixels from left)" />
            <TextBox x:Name="YBox" Width="52" Margin="6,2,0,2"
                     IsEnabled="{Binding IsChecked, ElementName=LocFixed}"
                     ToolTip="Y coordinate (pixels from top)" />
            <Button x:Name="PickBtn" Content="Pick…" Width="56" Margin="8,0,0,0"
                    IsEnabled="{Binding IsChecked, ElementName=LocFixed}"
                    Style="{StaticResource SmallButtonStyle}"
                    Click="PickBtn_Click"
                    ToolTip="Click anywhere on screen to capture coordinates" />
        </StackPanel>

        <!-- ── Separator: Stop Conditions ───────────────────────────────────── -->
        <Separator Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" />
        <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="Stop Conditions"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Background="{StaticResource BackgroundBrush}"
                   FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" Padding="4,0" />

        <!-- ── Stop After Clicks ────────────────────────────────────────────── -->
        <Label Grid.Row="8" Grid.Column="0" Content="After clicks:" />
        <TextBox Grid.Row="8" Grid.Column="1" x:Name="StopClicksBox" Text="0"
                 ToolTip="Stop after this many clicks (0 = unlimited)" />

        <!-- ── Stop After Seconds ───────────────────────────────────────────── -->
        <Label Grid.Row="9" Grid.Column="0" Content="After seconds:" />
        <TextBox Grid.Row="9" Grid.Column="1" x:Name="StopSecondsBox" Text="0"
                 ToolTip="Stop after this many seconds (0 = unlimited)" />

        <!-- ── Separator: Advanced ──────────────────────────────────────────── -->
        <Separator Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" />
        <TextBlock Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="Advanced"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Background="{StaticResource BackgroundBrush}"
                   FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" Padding="4,0" />

        <!-- ── Idle Wait + Always On Top ──────────────────────────────────── -->
        <Label Grid.Row="12" Grid.Column="0" Content="Idle wait (seconds):" />
        <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBox x:Name="IdleBox" Width="60" Text="0"
                     ToolTip="Wait this many seconds of system idle before starting (0 = disabled)" />
            <CheckBox x:Name="AlwaysOnTopBox" Content="Always on top"
                      Margin="14,0,0,0" VerticalAlignment="Center"
                      Checked="AlwaysOnTop_Changed" Unchecked="AlwaysOnTop_Changed" />
        </StackPanel>

        <!-- ── Hotkeys ──────────────────────────────────────────────────────── -->
        <Label Grid.Row="13" Grid.Column="0" Content="Hotkeys:" />
        <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Start:" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox x:Name="StartHotkeyBox" Width="60" IsReadOnly="True"
                     ToolTip="Click then press a key to set the start hotkey"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus"
                     LostFocus="HotkeyBox_LostFocus" />
            <TextBlock Text="Stop:" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" VerticalAlignment="Center" Margin="10,0,4,0" />
            <TextBox x:Name="StopHotkeyBox" Width="60" Text="F10" IsReadOnly="True"
                     ToolTip="Click then press a key to set the stop hotkey"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus"
                     LostFocus="HotkeyBox_LostFocus" />
        </StackPanel>

        <!-- ── Inline Error ─────────────────────────────────────────────────── -->
        <TextBlock x:Name="ErrorLabel"
                   Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="2"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12" TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <!-- ── Status ───────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="8" Height="8"
                     Fill="{StaticResource TextDisabledBrush}"
                     VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock x:Name="StatusLabel" Text="Stopped"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" VerticalAlignment="Center" />
            <TextBlock x:Name="ClickCountLabel"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- ── Start / Stop Button ──────────────────────────────────────────── -->
        <Button Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2"
                x:Name="StartStopBtn"
                Content="START"
                Style="{StaticResource StartButtonStyle}"
                Padding="0"
                Click="StartStopBtn_Click" />

        <!-- ── Version (subtle, bottom-right) ──────────────────────────────── -->
        <TextBlock Grid.Row="19" Grid.Column="0" Grid.ColumnSpan="2"
                   x:Name="VersionLabel"
                   HorizontalAlignment="Right"
                   Foreground="{StaticResource TextDisabledBrush}"
                   FontSize="9" Margin="0,1,2,0" />

        </Grid>
    </DockPanel>
</Window>
