<Window x:Class="QuadClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuadClicker"
        mc:Ignorable="d"
        Title="QuadClicker" Height="340" Width="480"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="14,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Click Rate -->
        <Label Grid.Row="0" Grid.Column="0" Content="Click Rate:" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ClickRateTextBox" Text="100ms"
                 ToolTip="Examples: 100ms  |  10 times per second  |  600 times per minute" />

        <!-- Click Location -->
        <Label Grid.Row="1" Grid.Column="0" Content="Click Location:" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <RadioButton x:Name="CurrentPositionRadioButton" Content="Current Position"
                         IsChecked="True" GroupName="ClickLocation" VerticalAlignment="Center" />
            <RadioButton x:Name="SpecificPositionRadioButton" Content="Specific Position"
                         GroupName="ClickLocation" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Coordinates -->
        <Label Grid.Row="2" Grid.Column="0" Content="Coordinates (X, Y):" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBox x:Name="XCoordinateTextBox" Width="55"
                     IsEnabled="{Binding IsChecked, ElementName=SpecificPositionRadioButton}"
                     ToolTip="X coordinate" />
            <TextBox x:Name="YCoordinateTextBox" Width="55" Margin="6,3,0,3"
                     IsEnabled="{Binding IsChecked, ElementName=SpecificPositionRadioButton}"
                     ToolTip="Y coordinate" />
            <Button x:Name="PickLocationButton" Content="Pick…" Width="60" Margin="8,0,0,0"
                    IsEnabled="{Binding IsChecked, ElementName=SpecificPositionRadioButton}"
                    Click="PickLocationButton_Click"
                    ToolTip="Click to select a point on screen" />
        </StackPanel>

        <!-- Idle Time -->
        <Label Grid.Row="3" Grid.Column="0" Content="Idle Time (seconds):" />
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="IdleTimeTextBox" Text="0"
                 ToolTip="Only start clicking after the system has been idle for this many seconds (0 = disabled)" />

        <!-- Stop After Clicks -->
        <Label Grid.Row="4" Grid.Column="0" Content="Stop After (clicks):" />
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="StopAfterClicksTextBox" Text="0"
                 ToolTip="Stop after this many clicks (0 = unlimited)" />

        <!-- Stop After Seconds -->
        <Label Grid.Row="5" Grid.Column="0" Content="Stop After (seconds):" />
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="StopAfterSecondsTextBox" Text="0"
                 ToolTip="Stop after this many seconds (0 = unlimited)" />

        <!-- Emergency Hotkey -->
        <Label Grid.Row="6" Grid.Column="0" Content="Emergency Stop Hotkey:" />
        <Label Grid.Row="6" Grid.Column="1" Content="F10"
               FontWeight="SemiBold" Foreground="#CC0000" />

        <!-- Spacer row 7 -->

        <!-- Start/Stop Button -->
        <Button Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                x:Name="StartStopButton"
                Content="Start"
                Background="Green"
                Foreground="White"
                FontSize="14"
                FontWeight="Bold"
                Height="36"
                Click="StartStopButton_Click" />
    </Grid>
</Window>